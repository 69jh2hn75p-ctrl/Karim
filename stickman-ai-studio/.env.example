# Copy to .env and fill in only what you use. Never commit .env.
# The MVP runs with no keys at all: story is hand-written, TTS is local espeak-ng,
# music and SFX are procedural.

# --- Story engine: manual (default, reads projects/episode-001/screenplay.json) | claude ---
STORY_PROVIDER=manual
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Text-to-speech: espeak (local, offline, default) | elevenlabs (needs the keys below) ---
TTS_PROVIDER=espeak
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_REN=
ELEVENLABS_VOICE_BO=
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Image provider (Stage 6+, not wired in the MVP yet) ---
IMAGE_PROVIDER=none
IMAGE_API_KEY=

# --- Rendering ---
# Path to a local chrome-headless-shell. Leave empty to let Remotion find one or download it.
# In this container: /opt/pw-browsers/chromium_headless_shell-1243/chrome-headless-shell-linux64/chrome-headless-shell
REMOTION_BROWSER_EXECUTABLE=
